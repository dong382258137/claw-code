__pycache__/
archive/
.omx/
# Environment files (contain API keys / secrets — never commit)
.env
.env.*
!.env.example
# Claude Code local artifacts
.claude/settings.local.json
.claude/sessions/
# Claw local artifacts (runtime state, sessions, subagents, plans — never commit)
.claw/
.vscode/
.clawhip/
# Local sandbox runtime state (transient, per-machine)
.sandbox-home/
# TUI scratch TODOs (transient)
.clawd-todos.json
# Agent dispatch cache (transient)
.clawd-agents/
# Per-workspace claw agent dispatch cache (transient)
**/.clawd-todos.json
**/.clawd-agents/
status-help.txt
# Legacy Python port session scratch artifacts
.port_sessions/
# Build artifacts
*.exe
target/

# Sandbox tmp (transient)
.sandbox-tmp/
**/.sandbox-tmp/

# Vendored reference sources (not a build dependency)
.vendor/

# Porting notes (deferred)
rust/crates/rusty-claude-cli/tui-ports/PORTING.md

# fastembed model cache (downloaded ONNX models)
.fastembed_cache/

# TUI debug screenshots and scripts (transient)
_claw_tui_*.png
_screenshot.ps1

# Temporary example/test scratch files
rust/crates/rusty-claude-cli/examples/

# Benchmark task data. Regenerable/intermediate fetch outputs stay ignored,
# but the *validated* pass^1 denominators are curated artifacts (each task
# survived two-sided validation) and MUST be version-controlled — see
# rust/crates/llm-eval/benchmarks/README.md for the frozen criteria.
rust/crates/llm-eval/benchmarks/*.jsonl
!rust/crates/llm-eval/benchmarks/groundtruth_validated.jsonl
!rust/crates/llm-eval/benchmarks/groundtruth_validated_40.jsonl
rust/crates/llm-eval/benchmarks/__pycache__/
